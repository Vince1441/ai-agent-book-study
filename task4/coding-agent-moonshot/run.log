{"type": "tool_execution_complete", "tool": "Read", "result": {"file_path": "D:\\AI\\ai-agent-book\\chapter5\\coding-agent-moonshot\\config.py", "total_lines": 190, "showing_lines": "1-190", "content": "     1|import os\n     2|from pathlib import Path\n     3|from dotenv import load_dotenv\n     4|\n     5|# Load environment variables\n     6|load_dotenv(Path(__file__).resolve().parent / \".env\")\n     7|\n     8|\n     9|class Config:\n    10|    \"\"\"Configuration class for the coding agent\"\"\"\n    11|\n    12|    # API Configuration\n    13|    ANTHROPIC_API_KEY = os.getenv(\"ANTHROPIC_API_KEY\")\n    14|    OPENAI_API_KEY = os.getenv(\"OPENAI_API_KEY\")\n    15|    OPENROUTER_API_KEY = os.getenv(\"OPENROUTER_API_KEY\")\n    16|    MOONSHOT_API_KEY = os.getenv(\"MOONSHOT_API_KEY\") or os.getenv(\"KIMI_API_KEY\")\n    17|    MOONSHOT_BASE_URL = os.getenv(\"MOONSHOT_BASE_URL\", \"https://api.moonshot.cn/v1\")\n    18|\n    19|    # 默认使用 Moonshot，也支持保留的兼容客户端。\n    20|    PROVIDER = os.getenv(\"PROVIDER\", \"moonshot\").lower()\n    21|\n    22|    # Default model\n    23|    DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"kimi-k3\")\n    24|\n    25|    # OpenRouter configuration\n    26|    OPENROUTER_BASE_URL = \"https://openrouter.ai/api/v1\"\n    27|\n    28|    # Agent configuration\n    29|    MAX_ITERATIONS = int(os.getenv(\"MAX_ITERATIONS\", \"50\"))\n    30|    MAX_TOKENS = int(os.getenv(\"MAX_TOKENS\", \"8192\"))\n    31|\n    32|    # System configuration\n    33|    WORKING_DIRECTORY = os.getenv(\"WORKING_DIRECTORY\", os.getcwd())\n    34|\n    35|    @classmethod\n    36|    def get_provider(cls) -> str:\n    37|        \"\"\"Get the configured provider\"\"\"\n    38|        return cls.PROVIDER\n    39|\n    40|    @classmethod\n    41|    def get_api_key(cls, provider: str = None) -> str:\n    42|        \"\"\"Get API key for specified provider (or configured provider if not specified)\"\"\"\n    43|        if provider is None:\n    44|            provider = cls.PROVIDER\n    45|\n    46|        if provider in (\"moonshot\", \"kimi\"):\n    47|            if not cls.MOONSHOT_API_KEY:\n    48|                raise ValueError(\"请配置 MOONSHOT_API_KEY 或 KIMI_API_KEY\")\n    49|            return cls.MOONSHOT_API_KEY\n    50|        elif provider == \"anthropic\":\n    51|            if not cls.ANTHROPIC_API_KEY:\n    52|                raise ValueError(\"ANTHROPIC_API_KEY not set in .env file\")\n    53|            return cls.ANTHROPIC_API_KEY\n    54|        elif provider == \"openai\":\n    55|            if not cls.OPENAI_API_KEY:\n    56|                raise ValueError(\"OPENAI_API_KEY not set in .env file\")\n    57|            return cls.OPENAI_API_KEY\n    58|        elif provider == \"openrouter\":\n    59|            if not cls.OPENROUTER_API_KEY:\n    60|                raise ValueError(\"OPENROUTER_API_KEY not set in .env file\")\n    61|            return cls.OPENROUTER_API_KEY\n    62|        else:\n    63|            raise ValueError(f\"Unknown provider: {provider}. Must be one of: anthropic, openai, openrouter\")\n    64|\n    65|    @classmethod\n    66|    def get_base_url(cls) -> str:\n    67|        \"\"\"Get base URL for the configured provider\"\"\"\n    68|        if cls.PROVIDER in (\"moonshot\", \"kimi\"):\n    69|            return cls.MOONSHOT_BASE_URL\n    70|        if cls.PROVIDER == \"openrouter\":\n    71|            return cls.OPENROUTER_BASE_URL\n    72|        return None  # Use default for anthropic/openai\n    73|\n    74|    @staticmethod\n    75|    def map_model_to_openrouter(model: str) -> str:\n    76|        \"\"\"Map a native (anthropic/openai) model id to an OpenRouter model id.\n    77|\n    78|        Used by the OpenRouter fallback so a user with ONLY an OPENROUTER_API_KEY\n    79|        can still run a task written for a direct provider.\n    80|\n    81|          - already-prefixed ids (contain \"/\") are passed through unchanged\n    82|          - claude-sonnet-* -> anthropic/claude-sonnet-4.6\n    83|          - claude-haiku-*  -> anthropic/claude-haiku-4.5\n    84|          - claude-opus-*   -> anthropic/claude-opus-4.8\n    85|          - any other claude-* -> anthropic/claude-opus-4.8\n    86|          - gpt-* / o1-*    -> openai/<model>\n    87|          - anything else   -> returned unchanged (best effort)\n    88|        \"\"\"\n    89|        if \"/\" in model:\n    90|            return model  # already an OpenRouter id\n    91|        m = model.lower()\n    92|        if m.startswith(\"claude\"):\n    93|            if \"haiku\" in m:\n    94|                return \"anthropic/claude-haiku-4.5\"\n    95|            if \"sonnet\" in m:\n    96|                return \"anthropic/claude-sonnet-4.6\"\n    97|            # opus, or any other/unknown Claude tier -> latest Opus\n    98|            return \"anthropic/claude-opus-4.8\"\n    99|        if m.startswith(\"gpt-\") or m.startswith(\"o1\"):\n   100|            return f\"openai/{model}\"\n   101|        return model\n   102|\n   103|    @classmethod\n   104|    def resolve(cls) -> dict:\n   105|        \"\"\"Resolve the effective (provider, api_key, base_url, model).\n   106|\n   107|        Applies the OpenRouter universal fallback: if the requested direct\n   108|        provider (anthropic/openai) has no API key configured, but an\n   109|        OPENROUTER_API_KEY is available, transparently route through OpenRouter\n   110|        (OpenAI-compatible SDK + prefixed model id). Default behavior is\n   111|        unchanged whenever the requested provider's own key is present.\n   112|\n   113|        Returns a dict: {provider, api_key, base_url, model,\n   114|                         requested_provider, fell_back}.\n   115|        \"\"\"\n   116|        requested = cls.PROVIDER\n   117|        model = cls.DEFAULT_MODEL\n   118|\n   119|        if requested in (\"moonshot\", \"kimi\"):\n   120|            if not model.strip() or cls.MAX_TOKENS < 2048:\n   121|                raise ValueError(\"请设置有效模型名称，并将 MAX_TOKENS 设置为至少 2048\")\n   122|            return {\n   123|                \"provider\": \"moonshot\",\n   124|                \"api_key\": cls.get_api_key(requested),\n   125|                \"base_url\": cls.MOONSHOT_BASE_URL,\n   126|                \"model\": model,\n   127|                \"requested_provider\": requested,\n   128|                \"fell_back\": False,\n   129|            }\n   130|\n   131|        # Explicit OpenRouter selection: use as configured (no mapping).\n   132|        if requested == \"openrouter\":\n   133|            return {\n   134|                \"provider\": \"openrouter\",\n   135|                \"api_key\": cls.get_api_key(\"openrouter\"),\n   136|                \"base_url\": cls.OPENROUTER_BASE_URL,\n   137|                \"model\": model,\n   138|                \"requested_provider\": requested,\n   139|                \"fell_back\": False,\n   140|            }\n   141|\n   142|        if requested in (\"anthropic\", \"openai\"):\n   143|            direct_key = cls.ANTHROPIC_API_KEY if requested == \"anthropic\" else cls.OPENAI_API_KEY\n   144|            if direct_key:\n   145|                # Direct provider key present -> behave exactly as before.\n   146|                return {\n   147|                    \"provider\": requested,\n   148|                    \"api_key\": direct_key,\n   149|                    \"base_url\": None,\n   150|                    \"model\": model,\n   151|                    \"requested_provider\": requested,\n   152|                    \"fell_back\": False,\n   153|                }\n   154|            # No direct key -> fall back to OpenRouter if we have that key.\n   155|            if cls.OPENROUTER_API_KEY:\n   156|                return {\n   157|                    \"provider\": \"openrouter\",\n   158|                    \"api_key\": cls.OPENROUTER_API_KEY,\n   159|                    \"base_url\": cls.OPENROUTER_BASE_URL,\n   160|                    \"model\": cls.map_model_to_openrouter(model),\n   161|                    \"requested_provider\": requested,\n   162|                    \"fell_back\": True,\n   163|                }\n   164|            key_name = \"ANTHROPIC_API_KEY\" if requested == \"anthropic\" else \"OPENAI_API_KEY\"\n   165|            raise ValueError(\n   166|                f\"No {key_name} set and no OPENROUTER_API_KEY available for fallback. \"\n   167|                f\"Set {key_name} for direct access, or set OPENROUTER_API_KEY to route \"\n   168|                f\"'{requested}' models through OpenRouter.\"\n   169|            )\n   170|\n   171|        raise ValueError(f\"Unknown provider: {requested}. Must be one of: anthropic, openai, openrouter\")\n   172|\n   173|    @classmethod\n   174|    def validate(cls):\n   175|        \"\"\"Validate configuration (fallback-aware).\"\"\"\n   176|        # resolve() raises a clear error if neither the direct key nor the\n   177|        # OpenRouter fallback key is available.\n   178|        resolved = cls.resolve()\n   179|        provider = cls.get_provider()\n   180|\n   181|        # Validate model name only when using the direct provider path; when we\n   182|        # fall back to OpenRouter the model id is remapped/prefixed, so the\n   183|        # native naming rules no longer apply.\n   184|        if not resolved[\"fell_back\"]:\n   185|            if provider == \"anthropic\" and not cls.DEFAULT_MODEL.startswith(\"claude\"):\n   186|                raise ValueError(f\"Model '{cls.DEFAULT_MODEL}' is not valid for Anthropic. Use a model starting with 'claude-'\")\n   187|            elif provider == \"openai\" and not any(cls.DEFAULT_MODEL.startswith(p) for p in [\"gpt-\", \"o1-\"]):\n   188|                raise ValueError(f\"Model '{cls.DEFAULT_MODEL}' is not valid for OpenAI. Use a model starting with 'gpt-' or 'o1-'\")\n   189|        # OpenRouter accepts any model name, so no validation needed\n   190|", "_metadata": {"tool": "Read", "call_number": 2, "timestamp": "2026-10-23 22:58:33"}}}
